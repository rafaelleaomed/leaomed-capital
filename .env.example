# =====================================================
# VARIÁVEIS DE AMBIENTE — PLATAFORMA FINANCEIRA
# =====================================================
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA commite o .env.local ou .env com valores reais.

# ----- Banco de Dados (Neon PostgreSQL) -----
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# ----- Supabase (Auth + Storage) -----
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# ----- Pluggy (Open Finance) -----
PLUGGY_CLIENT_ID=seu_client_id
PLUGGY_CLIENT_SECRET=seu_client_secret

# ----- Modo da Aplicação -----
# "production" | "demo"
APP_MODE=production

# ----- Next.js -----
NEXTAUTH_SECRET=gere_com_openssl_rand_base64_32
NEXTAUTH_URL=https://sua-url.vercel.app
